[Desktop Entry]
Type=Service
MimeType=all/all;
Actions=Preview;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1

[Desktop Action Preview]
Name=Preview with Space Previewer
Name[vi]=Xem nhanh bằng Space Previewer
Icon=space-previewer
Exec=/usr/bin/space-previewer --standalone %f
